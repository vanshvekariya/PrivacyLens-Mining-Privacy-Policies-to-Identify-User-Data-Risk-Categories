# ---- Dataset (large, redistributable, fully rebuildable) ----
# OPP-115 is ~100 MB extracted and the zip is close to GitHub's file size
# limit. src/README.md documents how to download and rebuild everything
# (including data/segments.csv) with src/build_dataset.py.
data/
data.zip

# Keep the small, fixed modern-policy evaluation snapshot reproducible while
# continuing to ignore the large OPP-115 corpus and derived primary dataset.
!data/
data/*
!data/generalization/
data/generalization/*
!data/generalization/manifest.csv
!data/generalization/manifest_resolved.csv
!data/generalization/build_report.txt
!data/generalization/raw/
data/generalization/raw/*
!data/generalization/raw/*.txt
!data/generalization/segments_unlabeled.csv
!data/generalization/annotations_raw.csv
!data/generalization/segments_adjudicated.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# ---- HuggingFace model cache (redownloadable) ----
.hf_cache/

# ---- Transformer per-fold Trainer scratch dir ----
results/transformer_runs/

# ---- MS Office temp/lock files (created while a doc is open in Word) ----
~$*
*.tmp
.~lock.*#

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- IDE / editor ----
.vscode/
.idea/
*.swp

# ---- Claude Code local settings (machine-specific permissions) ----
.claude/settings.local.json
